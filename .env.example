TESTCASE_AI_DATABASE_URL=mysql+pymysql://testcase:testcase@127.0.0.1:3306/testcase_ai
TESTCASE_AI_MILVUS_URI=http://127.0.0.1:19530
TESTCASE_AI_MILVUS_COLLECTION=testcase_ai_chunks
TESTCASE_AI_PROJECTS_ROOT=projects
TESTCASE_AI_OUTPUTS_ROOT=outputs

# OpenAI-compatible generation provider. Ollama example: http://127.0.0.1:11434/v1
TESTCASE_AI_LLM_BASE_URL=http://127.0.0.1:11434/v1
TESTCASE_AI_LLM_API_KEY=ollama
TESTCASE_AI_LLM_MODEL=qwen3:1.7b

# OpenAI-compatible embedding provider. It may use a different endpoint/model.
TESTCASE_AI_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
TESTCASE_AI_EMBEDDING_API_KEY=ollama
TESTCASE_AI_EMBEDDING_MODEL=bge-m3:latest

TESTCASE_AI_QUERY_REWRITE_ENABLED=false
TESTCASE_AI_RERANK_ENABLED=false
TESTCASE_AI_BIND_HOST=127.0.0.1
TESTCASE_AI_BIND_PORT=8000
