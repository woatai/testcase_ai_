{
  "$defs": {
    "Citation": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "source_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "evidence_id",
        "source"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ClarificationQuestion": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "affected_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Scope"
        }
      },
      "required": [
        "id",
        "question",
        "reason"
      ],
      "title": "ClarificationQuestion",
      "type": "object"
    },
    "GenerationStatus": {
      "enum": [
        "running",
        "succeeded",
        "needs_clarification",
        "failed"
      ],
      "title": "GenerationStatus",
      "type": "string"
    },
    "RequirementInput": {
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Name"
        }
      },
      "required": [
        "title",
        "content"
      ],
      "title": "RequirementInput",
      "type": "object"
    },
    "RetrievedEvidence": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "logical_id": {
          "title": "Logical Id",
          "type": "string"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "dense_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dense Rank"
        },
        "sparse_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sparse Rank"
        }
      },
      "required": [
        "evidence_id",
        "logical_id",
        "content",
        "source",
        "source_type",
        "score"
      ],
      "title": "RetrievedEvidence",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "policy",
        "business_rule",
        "workflow",
        "requirement",
        "api_spec",
        "glossary",
        "approved_case"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "TestCaseV1": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "applicable_versions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Applicable Versions",
          "type": "array"
        },
        "module": {
          "minLength": 1,
          "title": "Module",
          "type": "string"
        },
        "test_path": {
          "minLength": 1,
          "title": "Test Path",
          "type": "string"
        },
        "test_point": {
          "minLength": 1,
          "title": "Test Point",
          "type": "string"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "test_data": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Test Data",
          "type": "array"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "expected_result": {
          "minLength": 1,
          "title": "Expected Result",
          "type": "string"
        },
        "actual_result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Result"
        },
        "execution_status": {
          "anyOf": [
            {
              "enum": [
                "通过",
                "未通过"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Status"
        },
        "test_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Date"
        },
        "coverage_tags": {
          "items": {
            "type": "string"
          },
          "title": "Coverage Tags",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "evidence_status": {
          "default": "cited",
          "enum": [
            "cited",
            "inferred",
            "needs_clarification"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "duplicate_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Score"
        }
      },
      "required": [
        "case_id",
        "applicable_versions",
        "module",
        "test_path",
        "test_point",
        "preconditions",
        "test_data",
        "steps",
        "expected_result"
      ],
      "title": "TestCaseV1",
      "type": "object"
    }
  },
  "properties": {
    "generation_id": {
      "title": "Generation Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "project_version": {
      "title": "Project Version",
      "type": "string"
    },
    "knowledge_revision_id": {
      "title": "Knowledge Revision Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GenerationStatus"
    },
    "requirement": {
      "$ref": "#/$defs/RequirementInput"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/TestCaseV1"
      },
      "title": "Cases",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/RetrievedEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "clarifications": {
      "items": {
        "$ref": "#/$defs/ClarificationQuestion"
      },
      "title": "Clarifications",
      "type": "array"
    },
    "skipped_duplicates": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Skipped Duplicates",
      "type": "array"
    },
    "artifacts": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "object"
    },
    "model_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Profile"
    },
    "prompt_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Hash"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "generation_id",
    "project_id",
    "project_version",
    "knowledge_revision_id",
    "status",
    "requirement"
  ],
  "title": "GenerationResultV1",
  "type": "object"
}
